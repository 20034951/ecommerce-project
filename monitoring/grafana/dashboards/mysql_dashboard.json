{
  "id": null,
  "uid": "mysql_perf_dashboard",
  "title": "MySQL Performance Dashboard",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "MySQL Uptime",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 },
      "targets": [
        { "expr": "mysql_global_status_uptime", "legendFormat": "Uptime" }
      ]
    },
    {
      "type": "stat",
      "title": "Current Connections",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connections"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Threads",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running Threads"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Slow Queries (5m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 3 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "Slow Queries"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Queries per Second (QPS)",
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_questions[5m])",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transactions per Second (TPS)",
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_commands_commit[5m])",
          "legendFormat": "Commits"
        },
        {
          "expr": "rate(mysql_global_status_commands_rollback[5m])",
          "legendFormat": "Rollbacks"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Threads",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connected"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "MySQL Memory - Process RSS",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"mysql\"}",
          "legendFormat": "RSS Memory"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "InnoDB Buffer Pool Usage",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_data",
          "legendFormat": "Data"
        },
        {
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_dirty",
          "legendFormat": "Dirty"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "InnoDB I/O",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_data_reads[5m])",
          "legendFormat": "Reads"
        },
        {
          "expr": "rate(mysql_global_status_innodb_data_writes[5m])",
          "legendFormat": "Writes"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Temporary Tables",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_created_tmp_tables[5m])",
          "legendFormat": "Tmp Tables"
        },
        {
          "expr": "rate(mysql_global_status_created_tmp_disk_tables[5m])",
          "legendFormat": "Tmp Disk Tables"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Lock Waits",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_row_lock_waits[5m])",
          "legendFormat": "InnoDB Lock Waits"
        }
      ]
    }
  ]
}
