{
  "id": null,
  "uid": "cadvisor_dashboard",
  "title": "Container Metrics (cAdvisor)",
  "schemaVersion": 36,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{image!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Network RX/TX",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{image!=\"\"}[5m])",
          "legendFormat": "{{name}} RX"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{image!=\"\"}[5m])",
          "legendFormat": "{{name}} TX"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container Restarts",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "changes(container_last_seen{image!=\"\"}[1h])",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
